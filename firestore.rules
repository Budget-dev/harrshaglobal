rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // STRICT: Only authenticated user with email harrshaglobal@gmail.com has administrative privileges
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'harrshaglobal@gmail.com';
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'email', 'position', 'department', 'office', 'experience', 'createdAt'])
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
        && data.email is string && data.email.size() > 3 && data.email.size() <= 120
        && data.position is string && data.position.size() > 0 && data.position.size() <= 120
        && data.department is string && data.department.size() > 0 && data.department.size() <= 120
        && data.office is string && data.office.size() > 0 && data.office.size() <= 120
        && data.experience is string && data.experience.size() > 0 && data.experience.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Job Applications collection
    match /applications/{applicationId} {
      // Allow candidates to submit their application
      allow create: if isValidId(applicationId)
        && incoming().id == applicationId
        && isValidApplication(incoming());

      // STRICT ADMIN RESTRICTION: Only harrshaglobal@gmail.com can read, list, update, or delete applications
      allow read, update, delete: if isAdmin();
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
